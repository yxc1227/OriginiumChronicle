###########################################################
# 源石纪年 · 环境变量模板
#
# 开箱即用（默认 SQLite，不需要任何数据库服务）：
#   cp .env.example .env && php artisan key:generate && php artisan migrate:fresh --seed
#
# 这里把「改这个文件能调到什么」一次列全，而不只是列出「必须配的」——
# 项目用到的每一个变量都有可用默认值，不配也能跑起来（默认值见 config/*.php）。
# 变量对照表另见 README 的「Docker 与全部环境变量」一节。
###########################################################

APP_NAME="源石纪年"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 界面文案是硬编码中文，这里的 locale 只影响 Laravel 内置提示（校验、分页等）。
# 仓库没有 lang/ 目录 ⇒ 改成 zh_CN 反而会让内置提示缺翻译，保持 en 即可。
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# APP_ENV=local 时，登录页会出现「本地演示账号」（一键模拟一次外部授权，不发网络请求）。
# 它是**任何人点一下就登录**的通道，所以启用条件写死在 config/identity.php 里：
# 只有 local / testing 生效，生产环境无论如何都不会出现 —— 不需要你记得关。
APP_MAINTENANCE_DRIVER=file

# 开发服务器（php artisan serve）的并发进程数，需要时打开
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

###########################################################
# 系统版本号（覆盖点，不建议长期使用）
#
# 正源是 config/app.php 的 version 与 released_at。在这一份里再写一遍会多出一个真相，
# 发版时容易漏改一边（AppVersionTest 只能守住仓库内的三处，守不住本机 .env）。
# 只有「这台机器要固定跑某一版」时才临时覆盖。
# 发版流程见 CHANGELOG.md 开头。
###########################################################

# APP_VERSION=1.1.0
# APP_RELEASED_AT=2026-09-30

###########################################################
# 数据库
#
# 默认 SQLite：不依赖任何服务，适合先把站点跑起来看看。
# 换 MySQL / PostgreSQL 只需改连接信息 —— 代码里没有任何一处依赖具体驱动。
# 注意表前缀：本项目默认 arknight_（便于与其他项目共用一个库），留空即关闭。
###########################################################

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=arknight
# DB_USERNAME=root
# DB_PASSWORD=
# DB_PREFIX=arknight_

# 应用跑在容器里、数据库跑在宿主机上时（Docker Desktop for macOS / Windows）：
# 容器内的 127.0.0.1 指容器自身，必须走 host.docker.internal。
# DB_HOST=host.docker.internal

###########################################################
# 会话 / 缓存 / 队列
#
# 三者都走数据库（migrate 会建表），因此这个项目**不需要 Redis 或 Memcached**。
# 要换成别的驱动只改这几行即可，业务代码没有任何一处假设它是什么。
###########################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###########################################################
# 邮件
#
# 默认 log：邮件写进日志而不真的发出 —— 本地不会误发通知。
###########################################################

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###########################################################
# AI 梳理（AI 补全的提案来源）
#
# 模型输出**永远不会直接写进 events**，只落到 ai_proposals 等人工放行 ——
# 这条约束写在代码里，配置层不提供绕过它的开关。
#
# heuristic：纯规则的离线抽取，零依赖零成本，是默认值也是兜底。
# openai-compatible：任意兼容 OpenAI Chat Completions 的服务；**没有 Key 时静默降级回
# heuristic**，站点不会因为忘配 Key 而挂掉。
#
# TIMELINE_AI_KEY 只应存在于本机 .env 或部署平台的密钥管理里 —— 不要提交。
###########################################################

# TIMELINE_AI_DRIVER=openai-compatible
# TIMELINE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# TIMELINE_AI_KEY=
# TIMELINE_AI_MODEL=gpt-4o-mini
# TIMELINE_AI_TIMEOUT=60                # 单次请求超时（秒）
# TIMELINE_AI_MAX_CANDIDATES=25         # 单次梳理最多产出多少条提案（防止一次吐出一整本书）
# TIMELINE_AI_CONTEXT_LIMIT=60          # 注入上下文时携带的既有事件条数（供模型去重参考）
# TIMELINE_AI_LOW_CONFIDENCE=55         # 低于该置信度落低分档，审核面板会强提示

###########################################################
# 人物档案的外链目标（是链接目标，不是数据源）
#
# 本仓库只维护「与时间线相关的一行简介」，权威档案一律外链到各世界自己的维基：
# 与其在这里维护一份必然过时、又无法追溯出处的副本，不如把读者送过去。
# 做成配置是因为「换镜像站、换语言版本、对方改路径」都不该改代码。
#
# 塔卫二的 base 以「/wiki/干员/」结尾 —— 那个命名空间是真实链接反查确认的，
# 少写这一段会 404（见 config/timeline.php 的注释）。
###########################################################

# TIMELINE_WIKI_BASE=https://prts.wiki/w/
# TIMELINE_WIKI_LABEL="PRTS 维基"
# TIMELINE_TALOS_WIKI_BASE=https://www.fz.wiki/wiki/干员/
# TIMELINE_TALOS_WIKI_LABEL="终末地 WIKI"

###########################################################
# 账号与头像
###########################################################

# 自助注册：默认开放 —— 考据项目的纠错回路依赖「愿意留个名字的人」，
# 而注册出来的账号是预备干员（只读 + 可提交标注），越权风险为零。
# 公开入口同时也是垃圾账号入口，所以留了这个开关：关掉后注册页与提交都被拒绝，
# 已注册的账号不受任何影响。
# IDENTITY_REGISTRATION=true

# 头像：上限 2 MB，输出 256×256（居中裁剪；透明 PNG 压平时用面板底色，不会变成纯黑）。
# 刻意不支持 SVG —— 它能内嵌脚本，被浏览器当图片加载时仍可执行，是最典型的存储型 XSS 载体。
# 磁盘默认 public，但**不依赖 storage:link**：图片由控制器受控输出，不走静态直连。
# IDENTITY_AVATAR_DISK=public
# IDENTITY_AVATAR_MAX_KB=2048
# IDENTITY_AVATAR_SIZE=256
# IDENTITY_AVATAR_QUALITY=88

###########################################################
# 鹰角通行证（可选的外部登录渠道）
#
# 五项全空时登录页显示「未启用」，不影响其他功能；本地开发用上面的演示账号即可，
# 不必申请渠道。CLIENT_SECRET 只应存在于本机 .env 或密钥管理里 —— 不要提交。
###########################################################

# HYPERGRYPH_CLIENT_ID=
# HYPERGRYPH_CLIENT_SECRET=
# HYPERGRYPH_AUTHORIZE_URL=
# HYPERGRYPH_TOKEN_URL=
# HYPERGRYPH_USERINFO_URL=

###########################################################
# 协作与一致性巡检阈值（都调过，一般不用动）
#
# 这些是**判定规则的松紧**，不是功能开关：改动它们会改变一致性收件箱报什么，
# 而不是改变功能有没有。默认值见 config/timeline.php。
###########################################################

# TIMELINE_PER_PAGE=40                  # 每页时间线条目数
# TIMELINE_LEASE_SECONDS=300            # 编辑租约时长（前端每 60s 续租）
# TIMELINE_REVISION_KEEP=60             # 单条事件保留的版本快照数（永远保留首版）
# TIMELINE_DUPLICATE_SIMILARITY=0.82    # 标题相似度阈值（配合区间重叠判疑似重复）
# TIMELINE_OVERLOADED_DAY=12            # 同一节点条目数超过多少算「单日过载」
# TIMELINE_SOURCE_YEAR_TOLERANCE=1      # 出处引文年份与条目年份的容许差

###########################################################
# 日志
###########################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
